{
  "expo": {
    "name": "RentalMetrics",
    "slug": "rentalmetrics-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rentalmetrics-mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.uk.rentalmetrics.companion",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", {
        "image": "./assets/images/icon.png",
        "imageWidth": 160,
        "backgroundColor": "#ffffff"
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
